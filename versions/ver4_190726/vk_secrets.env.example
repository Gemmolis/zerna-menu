# Скопируйте этот файл как vk_secrets.env и подставьте значения.
# Файл vk_secrets.env в репозиторий не добавляйте (он в .gitignore).
# Переменные из реального окружения имеют приоритет над файлом.

VK_GROUP_TOKEN=
ADMIN_VK_PEER_ID=

# Яндекс.Диск: отдельный JSON на каждый заказ в указанной папке (необязательно).
# Токен: https://oauth.yandex.ru/ — права cloud_api:disk.write
# Папка создаётся автоматически, путь без ведущего /
YANDEX_DISK_TOKEN=
YANDEX_DISK_FOLDER=zerna-cafe-orders
